# ── OpenAI (platform.openai.com → API keys) ──────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Gmail OAuth (Google Cloud Console → Credentials → OAuth 2.0 Client) ───────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Slack (api.slack.com → Your App → OAuth & Permissions / Basic Info) ───────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# ── Gmail Pub/Sub (Google Cloud Console → Pub/Sub → Topics) ──────────────────
GMAIL_PUBSUB_TOPIC=projects/your-project-id/topics/gmail-push

# ── Agent behaviour ───────────────────────────────────────────────────────────
EMAIL_PROVIDER=fake           # fake | gmail | yahoo
DRY_RUN=true                  # set false to write to Gmail
SLACK_DIGEST_CHANNEL=#general
DIGEST_TIMEZONE=America/Toronto

# ── Web App / Postgres ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://emailagent:emailagent@localhost:5432/emailagent
REDIS_URL=redis://localhost:6379

# Token encryption key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# JWT secret for session cookies — any long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168          # 7 days

# Frontend origin (Chrome extension) — set to your extension's chrome-extension://<id> in production
# Leave as * for local development (extension ID changes on each load)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
